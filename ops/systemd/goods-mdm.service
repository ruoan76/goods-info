[Unit]
Description=Goods MDM FastAPI (gunicorn + UvicornWorker x2)
After=network.target postgresql.service
RequiresMountsFor=/data/projects/goods-info

[Service]
Type=notify
User=ubuntu
Group=ubuntu
WorkingDirectory=/data/projects/goods-info/apps/goods-mdm-api
Environment="PATH=/data/projects/goods-info/data/working/runtime/goods-mdm-api-venv/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/data/projects/goods-info/apps/goods-mdm-api/src"
EnvironmentFile=/etc/goods-mdm/service.env
ExecStart=/data/projects/goods-info/data/working/runtime/goods-mdm-api-venv/bin/python -m gunicorn -c /data/projects/goods-info/ops/deploy/gunicorn_conf.py app.main:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=goods-mdm

[Install]
WantedBy=multi-user.target
